{
  "expo": {
    "name": "CodeOnTheGo",
    "slug": "CodeOnTheGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/codeonthego-bird-icon.png",
    "scheme": "codeonthego",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codeonthego.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/codeonthego-bird-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.codeonthego.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icons/codeonthego-bird-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/codeonthego-bird-icon.png",
          "color": "#6564c7"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5028ba7f-437a-4eb7-ac2c-51b6425e93f0"
      }
    },
    "owner": "shaozhi",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/5028ba7f-437a-4eb7-ac2c-51b6425e93f0"
    }
  }
}
